{
  "name": "torrentstream",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "node apps/desktop/dev.mjs",
    "dev:web": "vite --config apps/desktop/vite.config.ts",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write apps packages tests *.json *.yaml",
    "format:check": "prettier --check apps packages tests *.json *.yaml",
    "lint": "eslint apps packages tests",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
